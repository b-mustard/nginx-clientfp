# nginx module config for ngx_http_clientfp_module (static: --add-module=<this dir>)

if [ "$HTTP_SSL" != YES ]; then
    echo "$0: error: ngx_http_clientfp_module requires --with-http_ssl_module"
    exit 1
fi

ngx_addon_name=ngx_http_clientfp_module

ngx_module_type=HTTP
ngx_module_name=ngx_http_clientfp_module
ngx_module_incs="$ngx_addon_dir/src"
ngx_module_deps="$ngx_addon_dir/src/clientfp_ja4.h $ngx_addon_dir/src/clientfp_tlsfp.h \
                 $ngx_addon_dir/src/clientfp_h2.h $ngx_addon_dir/src/clientfp_hello.h \
                 $ngx_addon_dir/src/clientfp_sha256.h"
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_clientfp_module.c \
                 $ngx_addon_dir/src/clientfp_ja4.c \
                 $ngx_addon_dir/src/clientfp_tlsfp.c \
                 $ngx_addon_dir/src/clientfp_h2.c \
                 $ngx_addon_dir/src/clientfp_hello.c \
                 $ngx_addon_dir/src/clientfp_sha256.c"
ngx_module_libs=
ngx_module_order=

. auto/module

have=NGX_HTTP_CLIENTFP . auto/have
