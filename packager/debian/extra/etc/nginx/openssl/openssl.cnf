# OpenSSL configuration for nginx-clientfp.
#
# nginx in this package is statically linked with its own OpenSSL, which reads this file (OPENSSLDIR is
# /etc/nginx/openssl) instead of the system /usr/lib/ssl/openssl.cnf. Changes take effect on nginx restart.
# Per-server TLS settings are usually better done with nginx's ssl_* and ssl_conf_command directives.
#
# Run "nginx -V" to see the bundled OpenSSL version. Configuration syntax: man 5 config (OpenSSL docs).

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_module

[ssl_module]
system_default = system_default_section

[system_default_section]
# Examples (uncomment to apply to every TLS context nginx creates):
# MinProtocol = TLSv1.2
# CipherString = DEFAULT:@SECLEVEL=2
# Groups = X25519MLKEM768:X25519:secp256r1:secp384r1
