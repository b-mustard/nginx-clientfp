     if (ngx_quic_write_buffer(c, &ctx->crypto, frame->data, f->length,
                               f->offset)
         == NGX_CHAIN_ERROR)
diff --git a/src/http/ngx_http_request.c b/src/http/ngx_http_request.c
index c8dff23..9da667d 100644
--- a/src/http/ngx_http_request.c
+++ b/src/http/ngx_http_request.c
@@ -761,6 +761,29 @@ ngx_http_ssl_handshake(ngx_event_t *rev)
             ngx_log_debug1(NGX_LOG_DEBUG_HTTP, rev->log, 0,
                            "https ssl handshake: 0x%02Xd", buf[0]);
 
+#if (NGX_HTTP_CLIENTFP)
+
+            /* wait until the whole ClientHello can be peeked */
+
+            if (ngx_http_clientfp_tls_hello(c) == NGX_AGAIN) {
+                rev->ready = 0;
+
+                if (!rev->timer_set) {
+                    cscf = ngx_http_get_module_srv_conf(hc->conf_ctx,
+                                                        ngx_http_core_module);
+                    ngx_add_timer(rev, cscf->client_header_timeout);
+                    ngx_reusable_connection(c, 1);
+                }
+
+                if (ngx_handle_read_event(rev, 0) != NGX_OK) {
+                    ngx_http_close_connection(c);
+                }
+
+                return;
+            }
+
+#endif
+
             clcf = ngx_http_get_module_loc_conf(hc->conf_ctx,
                                                 ngx_http_core_module);
 
